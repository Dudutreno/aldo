rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni utente legge e scrive solo dentro utenti/{il suo uid}. Tutto il resto è chiuso.
    match /utenti/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
